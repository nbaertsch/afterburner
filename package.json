{
  "name": "copilot-afterburner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "go test ./... && npm run test:black-box && npm run test:compatibility && npm run test:ui-mods && npm run test:byomodels-runtime",
    "test:native": "go test ./...",
    "test:black-box": "npm test --prefix extensions/BlackBox",
    "test:compatibility": "node --test tests/request-compatibility.test.mjs",
    "test:ui-mods": "node --test tests/ui-mods.test.mjs",
    "test:byomodels-runtime": "node --test extensions/BYOModels/runtime/extension.test.mjs"
  },
  "devDependencies": {
    "node-pty": "^1.1.0"
  }
}
