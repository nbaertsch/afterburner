{
  "name": "copilot-afterburner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "check:runtime": "node scripts/sync-runtime.mjs --check",
    "test": "npm run test:black-box && npm run test:openai-server && npm run test:compatibility",
    "test:native": "go test ./...",
    "test:black-box": "npm test --prefix extensions/BlackBox",
    "test:openai-server": "npm test --prefix extensions/OpenAIServer",
    "test:compatibility": "node --test internal/runtimepkg/*.test.mjs tests/request-compatibility.test.mjs tests/replay-blackbox-tui.test.mjs",
    "test:release-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-release.ps1",
    "test:real-tui:black-box": "node tests/real-blackbox-modal-tui.mjs",
    "test:real-tui:openai-server": "node tests/real-openai-server-menu-tui.mjs artifacts/afterburn.exe",
    "replay:real-tui:black-box": "node tests/replay-blackbox-tui.mjs"
  },
  "devDependencies": {
    "node-pty": "^1.1.0"
  }
}
