{
  "$schema": "../../schemas/extension-v1.schema.json",
  "schemaVersion": 1,
  "id": "openai-server",
  "displayName": "OpenAI Server",
  "description": "Exposes the active Copilot session model catalog through a localhost OpenAI-compatible API when enabled.",
  "visibility": "builtin",
  "requires": {
    "afterburner": ">=0.1.0 <1.0.0",
    "copilotCli": [">=1.0.83-1"]
  },
  "runtime": {
    "entrypoint": "runtime/extension.mjs",
    "execution": "in-process"
  },
  "capabilities": ["session-command", "modal-canvas"],
  "ui": {
    "protocol": "afterburner.ui",
    "revision": 1,
    "surfaces": [
      {
        "id": "openai-server",
        "kind": "modal",
        "title": "OpenAI Server"
      },
      {
        "id": "copilot-openai",
        "kind": "modal",
        "title": "Copilot OpenAI"
      }
    ]
  },
  "sessionExtension": {
    "entrypoint": "com.github.copilot/extensions/OpenAIServer/extension.mjs"
  }
}
