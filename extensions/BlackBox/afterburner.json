{
  "$schema": "../../schemas/extension-v1.schema.json",
  "schemaVersion": 1,
  "id": "black-box",
  "displayName": "Black Box",
  "description": "Records a bounded, metadata-only operational timeline for Afterburner-managed Copilot sessions.",
  "visibility": "builtin",
  "requires": {
    "afterburner": ">=0.1.0 <1.0.0",
    "copilotCli": [">=1.0.83-1 <1.0.84"]
  },
  "runtime": {
    "entrypoint": "runtime/extension.mjs",
    "execution": "in-process"
  },
  "capabilities": [
    "runtime-observer",
    "metadata-timeline",
    "sanitized-export",
    "modal-canvas",
    "enterprise-surface"
  ],
  "sessionExtension": {
    "entrypoint": "com.github.copilot/extensions/BlackBox/extension.mjs"
  },
  "ui": {
    "protocol": "afterburner.ui",
    "revision": 1,
    "surfaces": [
      {
        "id": "afterburner-black-box-live",
        "kind": "panel",
        "title": "Afterburner Black Box",
        "requiredCapabilities": [
          "ui.render.components",
          "ui.surface.panel",
          "ui.action.invoke",
          "ui.data.read",
          "ui.stream.read",
          "ui.localization.read",
          "ui.accessibility.inspect"
        ]
      }
    ],
    "capabilities": [
      "ui.render.components",
      "ui.surface.panel",
      "ui.action.invoke",
      "ui.data.read",
      "ui.stream.read",
      "ui.localization.read",
      "ui.accessibility.inspect",
      "ui.observability.black-box.sink"
    ],
    "grantPolicy": {
      "schemaVersion": 1,
      "protocol": "afterburner.ui",
      "revision": 1,
      "extensionId": "black-box",
      "denyByDefault": true,
      "grants": [
        {
          "id": "black-box-panel-render",
          "effect": "allow",
          "capabilities": ["ui.render.components", "ui.surface.panel", "ui.action.invoke", "ui.data.read", "ui.stream.read", "ui.localization.read", "ui.accessibility.inspect"],
          "resources": ["afterburner-black-box-live"]
        },
        {
          "id": "black-box-metadata-observability",
          "effect": "allow",
          "capabilities": ["ui.observability.black-box.sink"],
          "resources": ["afterburner.ui/envelopes/metadata"]
        }
      ],
      "audit": [
        {
          "id": "black-box-ui-observability-redaction",
          "events": ["ui.host.lifecycle", "ui.host.patch", "ui.host.recovery", "ui.host.quota", "ui.host.arbitration"],
          "sinkIds": ["black-box.ui.events"],
          "redaction": "metadata-only"
        }
      ]
    },
    "observability": {
      "eventSinks": [
        {
          "id": "black-box.ui.events",
          "extensionId": "black-box",
          "requirement": "optional",
          "capability": "ui.observability.black-box.sink",
          "failureBehavior": "ignore-when-absent"
        }
      ]
    }
  }
}
