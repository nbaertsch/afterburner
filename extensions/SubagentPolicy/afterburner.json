{
  "$schema": "../../schemas/extension-v1.schema.json",
  "schemaVersion": 1,
  "id": "subagent-policy-local",
  "displayName": "Subagent Policy",
  "description": "Applies configurable session-scoped model routing, concurrency, depth, and visibility policies to Copilot subagents.",
  "visibility": "private",
  "requires": {
    "afterburner": ">=0.1.0 <1.0.0",
    "copilotCli": [">=1.0.84-4"]
  },
  "runtime": {
    "entrypoint": "runtime/extension.mjs",
    "execution": "in-process"
  },
  "capabilities": ["session-command", "modal-canvas"],
  "ui": {
    "protocol": "afterburner.ui",
    "revision": 1,
    "surfaces": [
      {
        "id": "subagent-policy",
        "kind": "modal",
        "title": "Subagent Policy"
      }
    ]
  },
  "sessionExtension": {
    "entrypoint": "com.github.copilot/extensions/SubagentPolicy/extension.mjs"
  }
}
