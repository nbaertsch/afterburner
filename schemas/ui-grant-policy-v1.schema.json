{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/ui-grant-policy-v1.schema.json",
  "title": "Afterburner UI grant policy",
  "type": "object",
  "required": ["schemaVersion", "protocol", "revision", "extensionId", "denyByDefault", "grants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "afterburner.ui" },
    "revision": { "const": 1 },
    "extensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "denyByDefault": { "type": "boolean" },
    "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } },
    "audit": { "type": "array", "items": { "$ref": "#/$defs/audit" } },
    "quotas": { "type": "array", "items": { "$ref": "#/$defs/quota" } },
    "keyEpoch": { "type": "integer", "minimum": 0 },
    "acceptedKeyEpochs": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
    "rotationOverlapMillis": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "$defs": {
    "grant": {
      "type": "object",
      "required": ["id", "effect", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["allow", "deny", "audit"] },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
        "resources": {
          "type": "array",
          "description": "Resource identifiers covered by the grant. For ui.action.invoke, a surface ID grants every action on that surface; use surfaceId/actionId for action-specific scope.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "conditions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["id", "events"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "events": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "sinkIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "redaction": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quota": {
      "type": "object",
      "required": ["id", "quotaId", "hardFail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "quotaId": { "type": "string", "minLength": 1 },
        "hardFail": { "type": "boolean" },
        "auditEvent": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capability": { "type": "string", "pattern": "^ui\\.[a-z0-9.-]+$" }
  }
}
