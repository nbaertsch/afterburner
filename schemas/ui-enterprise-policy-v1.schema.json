{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/ui-enterprise-policy-v1.schema.json",
  "title": "Afterburner UI enterprise policy",
  "type": "object",
  "required": ["schemaVersion", "version", "denyByDefault"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "denyByDefault": {
      "type": "boolean",
      "description": "When true, declared capabilities require an active runtime grant after hard identity, capability, safe-mode, and deny constraints pass. When false, declared capabilities are allowed without a grant unless a hard constraint or explicit deny blocks them."
    },
    "safeMode": { "type": "boolean" },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "effect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["allow", "deny"] },
          "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^ui\\.[a-z0-9.-]+$" }, "uniqueItems": true },
          "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "requireBuiltinSigned": { "type": "boolean" },
          "minimumRegistryEpoch": { "type": "integer", "minimum": 0 },
          "revokedSigners": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
