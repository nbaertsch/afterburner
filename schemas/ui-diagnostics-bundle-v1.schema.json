{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/ui-diagnostics-bundle-v1.schema.json",
  "title": "Afterburner UI diagnostics bundle manifest",
  "type": "object",
  "required": ["schemaVersion", "protocol", "revision", "bundleId", "metadataOnly", "createdAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "afterburner.ui" },
    "revision": { "const": 1 },
    "bundleId": { "type": "string", "minLength": 1 },
    "metadataOnly": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "sizeBytes", "redaction", "metadataOnly"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "redaction": { "enum": ["metadata-only", "allowlist"] },
          "allowedFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "excludedFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "metadataOnly": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
