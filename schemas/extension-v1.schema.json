{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/extension-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "visibility", "requires", "runtime"],
  "anyOf": [
    { "required": ["displayName"] },
    { "required": ["name"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "description": "Legacy display label; prefer displayName for new manifests." },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "visibility": { "enum": ["builtin", "public", "private"] },
    "requires": {
      "type": "object",
      "required": ["afterburner"],
      "properties": {
        "afterburner": { "type": "string" },
        "copilotCli": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["entrypoint", "execution"],
      "properties": {
        "entrypoint": { "type": "string" },
        "execution": { "const": "in-process" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "description": "Declared Afterburner capability, such as model-picker, application-source-transform, runtime-observer, canvas, or modal-canvas."
      },
      "uniqueItems": true
    },
    "sessionExtension": {
      "type": "object",
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ui": {
      "$ref": "extension-ui-v1.schema.json",
      "description": "Optional afterburner.ui declaration. Existing schemaVersion 1 manifests remain valid when omitted."
    }
  },
  "additionalProperties": false
}
