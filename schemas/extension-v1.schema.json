{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/extension-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "requires", "runtime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "visibility": { "enum": ["builtin", "public", "private"] },
    "requires": {
      "type": "object",
      "required": ["afterburner"],
      "properties": {
        "afterburner": { "type": "string" },
        "copilotCli": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["entrypoint", "execution"],
      "properties": {
        "entrypoint": { "type": "string" },
        "execution": { "const": "in-process" }
      },
      "additionalProperties": false
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "companionPlugin": {
      "type": "object",
      "required": ["manifest", "required"],
      "properties": {
        "manifest": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
