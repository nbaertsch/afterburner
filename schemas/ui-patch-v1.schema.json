{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/ui-patch-v1.schema.json",
  "title": "Afterburner UI patch",
  "type": "object",
  "required": ["schemaVersion", "protocol", "revision", "surfaceId", "baseRevision", "nextRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "afterburner.ui" },
    "revision": { "const": 1 },
    "surfaceId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "nextRevision": { "type": "integer", "minimum": 0 },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } }
  },
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["op", "path"],
      "properties": {
        "op": { "enum": ["add", "remove", "replace", "move", "copy", "test", "setProps", "bindData", "bindAction"] },
        "path": { "type": "string", "minLength": 1 },
        "from": { "type": "string" },
        "value": true,
        "guard": true,
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
