{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/ui-audit-event-v1.schema.json",
  "title": "Afterburner UI audit event",
  "type": "object",
  "required": ["schemaVersion", "protocol", "revision", "id", "type", "actorKind", "actorId", "at"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "afterburner.ui" },
    "revision": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "actorKind": { "enum": ["host", "extension", "renderer", "surface", "sdk", "black-box", "policy", "reconciler", "terminal", "unspecified"] },
    "actorId": { "type": "string", "minLength": 1 },
    "surfaceId": { "type": "string" },
    "envelopeId": { "type": "string" },
    "decision": { "enum": ["allow", "deny", "audit"] },
    "reason": { "type": "string", "maxLength": 256 },
    "at": { "type": "string", "format": "date-time" },
    "attributes": {
      "type": "object",
      "propertyNames": { "enum": ["hostId", "surfaceId", "instanceId", "extensionId", "capability", "resource", "grantId", "grantEpoch", "registryEpoch", "policyVersion", "reason", "state", "result", "opaqueId", "counter"] },
      "additionalProperties": { "type": "string", "maxLength": 256 }
    }
  },
  "additionalProperties": false
}
