{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbaertsch/afterburner/schemas/extension-ui-v1.schema.json",
  "title": "Afterburner native extension UI declaration",
  "type": "object",
  "required": ["protocol", "revision", "surfaces"],
  "properties": {
    "protocol": { "const": "afterburner.ui" },
    "revision": { "const": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "kind": { "const": "modal" },
          "title": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
